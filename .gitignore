# ====================================================================
# Python / FastAPI Standard
# ====================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables / Secrets (NEVER commit these)
.env
.env.*
!.env.example

# ====================================================================
# Development Tools / Linting / Testing
# ====================================================================
# pytest and coverage
.pytest_cache/
.htmlcov/
htmlcov/
.coverage
.coverage.*

# Linters and type checkers (Ruff, MyPy)
.ruff_cache/
.mypy_cache/

# IDEs / Editors (VS Code, Cursor, IntelliJ, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ====================================================================
# Jinja2 / Frontend (Web App Specific)
# ====================================================================
# Jinja2 template cache (if enabled)
.webassets-cache/

# Frontend build tools (if using Tailwind CSS, Vite, Node.js, etc.)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ====================================================================
# OS Specific Files
# ====================================================================
.DS_Store
.DS_Store?
Thumbs.db
Ehthumbs.db
